APP_ENV=production
NODE_ENV=production
PORT=4000
DATABASE_URL=replace-with-managed-production-database-url
JWT_SECRET=replace-with-a-random-production-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
TRACEABILITY_SIGNING_SECRET=replace-with-a-separate-production-secret-at-least-32-characters
CORS_ORIGIN=https://app.example.com
APP_VERSION=0.0.42-beta
OTP_PROVIDER=twofactor
TWOFACTOR_API_KEY=replace-with-production-provider-key
TWOFACTOR_BASE_URL=https://2factor.in
NOTIFICATION_SMS_PROVIDER=twofactor
NOTIFICATION_SMS_ENABLED=true
TWOFACTOR_SMS_SENDER_ID=replace-with-approved-sender-id
NOTIFICATION_PUSH_PROVIDER=fcm
NOTIFICATION_PUSH_ENABLED=true
FCM_PROJECT_ID=replace-with-production-project-id
FCM_CLIENT_EMAIL=replace-with-production-service-account-email
FCM_PRIVATE_KEY=replace-with-production-service-account-private-key
GEMINI_API_KEY=replace-with-production-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
STORAGE_PROVIDER=s3
LOCAL_UPLOAD_PUBLIC=false
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=replace-with-production-private-bucket
S3_ACCESS_KEY_ID=replace-with-production-access-key
S3_SECRET_ACCESS_KEY=replace-with-production-secret-key
S3_PUBLIC_BASE_URL=
RATE_LIMIT_STORE=database
OTP_REQUEST_WINDOW_MINUTES=2
DATASET_EXPORT_SALT=replace-with-production-export-salt
